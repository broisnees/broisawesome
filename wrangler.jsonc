{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2025-04-04",
  "main": "@tanstack/react-start/server-entry",
  "routes": [
    "nischal-dahal.com.np/*",
    "www.nischal-dahal.com.np/*",
    "nischal-dahal.com.np"
  ],
  "preview_urls": true,
  "kv_namespaces": [
    {
      "binding": "NEWSLETTER_KV",
      "id": "8f5b81d6febc48839c35535fa1f89a58"
    }
  ],
  // Say hi: at most 5 messages a minute from one IP.
  "ratelimits": [
    {
      "name": "HI_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "CLASH_ROYALE_API_TOKEN": "",
    "CLASH_ROYALE_PLAYER_TAG": "",
    "CLASH_OF_CLANS_API_TOKEN": "",
    "CLASH_OF_CLANS_PLAYER_TAG": "",
    "LICHESS_USERNAME": "broisnees",
    "YOUTUBE_API_KEY": "",
    "GOOGLE_OAUTH_CLIENT_ID": "",
    "GOOGLE_OAUTH_CLIENT_SECRET": "",
    "YOUTUBE_REFRESH_TOKEN": "",
    "GOOGLE_PHOTOS_ALBUM_ID": "",
    "GOOGLE_PHOTOS_REFRESH_TOKEN": "",
    "LOG_JSON_URL": "https://raw.githubusercontent.com/broisnees/nischaldahal/main/public/log-content.json",
    "GITHUB_USERNAME": "broisnischal",
    // GITHUB_TOKEN is a secret (wrangler secret put GITHUB_TOKEN), not a var:
    // a var with the same name would clash with it.
    "GITHUB_OAUTH_CLIENT_ID": "Iv23liBMPOZh14apF81c",
    "GITHUB_OAUTH_CLIENT_SECRET": "",
    "NPM_USERNAME": "neeswebservice"
  },
  "compatibility_flags": ["nodejs_compat", "nodejs_als"],
  "observability": {
    "logs": {
      "enabled": false,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
